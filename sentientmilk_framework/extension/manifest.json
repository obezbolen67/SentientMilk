{
  "manifest_version": 3,
  "name": "SentientMilk",
  "description": "Lets her use this Chrome, with your sign-ins, in tabs of her own, when you ask her to.",
  "version": "0.13.0",
  "key": "",
  "background": {"service_worker": "background.js"},
  "permissions": ["debugger", "tabs", "downloads", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {"default_popup": "popup.html", "default_title": "SentientMilk"}
}
