{
  "manifest_version": 3,
  "name": "SentientMilk",
  "description": "Lets her use this Chrome, with your sign-ins, in tabs of her own, when you ask her to.",
  "version": "0.16.0",
  "key": "",
  "background": {"service_worker": "background.js"},
  "permissions": ["debugger", "tabs", "tabGroups", "downloads", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "icons": {"16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png", "128": "icons/on-128.png"},
  "action": {
    "default_popup": "popup.html",
    "default_title": "SentientMilk",
    "default_icon": {"16": "icons/off-16.png", "32": "icons/off-32.png", "48": "icons/off-48.png", "128": "icons/off-128.png"}
  }
}
